---
// Aperçu des services sur l'accueil, rendu en galerie horizontale.
// Le défilement latéral est toujours disponible, y compris en
// prefers-reduced-motion : il est déclenché par le visiteur, pas subi. Seule
// la course pilotée (section épinglée, piste translatée au fil du scroll) est
// réservée à ceux qui acceptent le mouvement. Un seul balisage pour les deux :
// c'est la CSS (global.css, .hscroll-*) et scripts/motion.ts
// (initHorizontalGallery) qui décident, jamais un second balisage.
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import StyledText from './StyledText.astro';

const servicesEntry = await getEntry('services', 'services');
const sectionsEntry = await getEntry('sections', 'sections');
const uiEntry = await getEntry('interface', 'interface');
const services = servicesEntry!.data;
const sections = sectionsEntry!.data;
const ui = uiEntry!.data;
---

<section data-hscroll class="reveal-section py-16 md:py-20">
  <div class="hscroll-viewport">
    <div class="w-full">
      <div class="mx-auto max-w-6xl px-6">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.12em] text-accent">{sections.servicesEyebrow}</p>
            <StyledText
              as="h2"
              data-split
              alignement={sections.servicesTitre.alignement}
              police={sections.servicesTitre.police}
              taille={sections.servicesTitre.taille}
              class="mt-4 max-w-2xl font-bold leading-tight text-text"
            >
              {sections.servicesTitre.texte}
            </StyledText>
          </div>
          <a
            href="/services"
            class="inline-flex shrink-0 items-center gap-2 font-mono text-sm text-accent transition-transform duration-300 hover:translate-x-1"
          >
            {ui.services.voirTous}
          </a>
        </div>
      </div>

      <div class="mt-10 lg:mt-14">
        <!-- tabindex : une zone qui défile doit être atteignable au clavier (flèches).
             Le JS le retire quand la piste est épinglée — elle ne défile plus
             alors, et ce serait un arrêt de tabulation sans effet. -->
        <div
          data-hscroll-track
          class="hscroll-track"
          role="group"
          aria-label="Services — faire défiler horizontalement"
          tabindex="0"
        >
          {services.cartes.map((carte, i) => (
            <article
              data-project-tilt
              class="hscroll-panel group relative flex flex-col justify-between overflow-hidden rounded-card border border-surface-2 bg-surface p-7 transition-colors duration-300 hover:border-accent/40 lg:min-h-[22rem] lg:p-9"
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute -right-2 -top-6 font-display text-[6rem] font-bold leading-none text-text opacity-[0.045] transition-opacity duration-500 group-hover:opacity-[0.09] lg:text-[8rem]"
              >
                {String(i + 1).padStart(2, '0')}
              </span>

              <div class="relative">
                <div class="grid h-11 w-11 place-items-center rounded-full border border-surface-2 text-accent transition-colors duration-300 group-hover:border-accent/50">
                  <Icon name={carte.icone} size={20} />
                </div>
                <StyledText
                  as="h3"
                  alignement={carte.titre.alignement}
                  police={carte.titre.police}
                  taille={carte.titre.taille}
                  class="mt-5 font-medium leading-snug text-text"
                >
                  {carte.titre.texte}
                </StyledText>
                <StyledText
                  as="p"
                  alignement={carte.phrase.alignement}
                  police={carte.phrase.police}
                  taille={carte.phrase.taille}
                  class="mt-3 leading-relaxed text-text-muted"
                >
                  {carte.phrase.texte}
                </StyledText>
              </div>
            </article>
          ))}
        </div>

        {/* Repère de progression : visible seulement quand la piste est réellement
            parcourue horizontalement (jamais en grille reduced-motion). */}
        <div data-hscroll-rail class="mx-auto mt-10 hidden max-w-6xl px-6">
          <div class="h-px w-full bg-surface-2">
            <div data-hscroll-progress class="hscroll-progress h-px bg-accent"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* La grille reduced-motion doit aussi retrouver une gouttière verticale. */
  @media (prefers-reduced-motion: reduce) {
    :global(.hscroll-track) {
      gap: 1.5rem;
      padding-inline: 1.5rem;
    }
  }
</style>
