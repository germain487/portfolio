---
// Pied de page réduit à la seule mention de signature, centrée. Les liens de
// navigation, les coordonnées et les réseaux sociaux vivent ailleurs (navbar
// et page Contact) : les répéter ici n'apportait rien.
import { getEntry } from 'astro:content';

const footerEntry = await getEntry('footer', 'footer');
const footer = footerEntry!.data;

const year = new Date().getFullYear();
---

<footer class="border-t border-surface-2 bg-surface" transition:persist>
  <div class="mx-auto max-w-6xl px-6 py-10">
    <p class="text-center font-mono text-xs text-text-muted">© {year} · {footer.mention}</p>
  </div>
</footer>
