---
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import HexPortrait from './HexPortrait.astro';
import MagneticButton from './MagneticButton.astro';
import StyledText from './StyledText.astro';

const settingsEntry = await getEntry('settings', 'settings');
const heroEntry = await getEntry('hero', 'hero');
const settings = settingsEntry!.data;
const hero = heroEntry!.data;

const socialIconMap: Record<string, string> = {
  LinkedIn: 'linkedin',
  GitHub: 'github',
  Facebook: 'facebook',
};

// WhatsApp n'est pas dans la liste des réseaux : son lien est dérivé du
// numéro des réglages généraux, seule source de vérité — sinon le numéro
// vivrait à deux endroits et l'un des deux finirait périmé.
const socials = [
  ...settings.reseaux.map((reseau) => ({
    label: reseau.plateforme,
    href: reseau.url,
    icone: socialIconMap[reseau.plateforme] ?? 'globe',
  })),
  { label: 'WhatsApp', href: `https://wa.me/${settings.whatsapp}`, icone: 'whatsapp' },
];
---

<section
  id="accueil"
  data-hero
  data-roles={JSON.stringify(hero.roles)}
  class="hero relative overflow-hidden pt-40 pb-16 md:pt-48 md:pb-20"
  style="visibility:hidden;"
>
  <div class="mx-auto grid max-w-6xl items-center gap-16 px-6 md:grid-cols-2">
    <div class="order-2 md:order-1">
      <StyledText
        as="p"
        data-hero-eyebrow
        alignement={hero.eyebrow.alignement}
        police={hero.eyebrow.police}
        taille={hero.eyebrow.taille}
        class="uppercase tracking-[0.12em] text-accent"
      >
        {hero.eyebrow.texte}
      </StyledText>

      <h1
        data-hero-name
        class="mt-4 font-display text-[clamp(2.5rem,6vw,4.5rem)] font-bold leading-[1.05] text-text"
      >
        {settings.nomComplet}
      </h1>

      <p
        data-hero-role
        class="mt-4 flex items-center gap-1 font-display text-xl font-medium text-accent md:text-2xl"
      >
        <span aria-hidden="true" data-typewriter>{hero.roles[0]}</span>
        <span aria-hidden="true" class="typewriter-cursor">|</span>
        <span class="sr-only">{hero.roles.join(' · ')}</span>
      </p>

      <StyledText
        as="p"
        data-hero-tagline
        alignement={hero.accroche.alignement}
        police={hero.accroche.police}
        taille={hero.accroche.taille}
        class="mt-6 max-w-md leading-[1.7] text-text-muted"
      >
        {hero.accroche.texte}
      </StyledText>

      <div data-hero-cta class="mt-8 flex flex-wrap items-center gap-4">
        {settings.cv && (
          <MagneticButton href={settings.cv} download variant="primary">
            <Icon name="download" size={16} />
            {hero.ctaPrimaireLabel}
          </MagneticButton>
        )}
        <MagneticButton href="/projets" variant="secondary">
          {hero.ctaSecondaireLabel}
        </MagneticButton>
      </div>

      <div class="mt-16 flex items-center gap-3">
        {socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.label}
            class="grid h-10 w-10 place-items-center rounded-full border border-surface-2 text-text-muted transition-all duration-300 hover:border-accent hover:bg-accent hover:text-bg hover:shadow-[var(--glow)]"
          >
            <Icon name={social.icone} size={17} />
          </a>
        ))}
      </div>
    </div>

    <div class="order-1 md:order-2" data-hero-hex-glow style="opacity:0;">
      <HexPortrait src={hero.portrait} alt={`Portrait de ${settings.nomComplet}`} />

      <div class="mt-8 flex justify-center">
        <MagneticButton href="/contact" class="btn-sweep">
          {/* Au-dessus de l'onde de lumière, qui balaie le fond du bouton. */}
          <span class="relative z-[2] inline-flex items-center gap-2">
            {hero.ctaContactLabel}
            <span class="btn-sweep-icon grid place-items-center"><Icon name="arrow-right" size={15} /></span>
          </span>
        </MagneticButton>
      </div>
    </div>
  </div>
</section>

<!-- Le typewriter, l'intro GSAP et le tilt du portrait sont (ré)initialisés
     de façon centralisée par scripts/bootstrap.ts sur `astro:page-load`,
     pas ici : voir Base.astro. -->

<style>
  .typewriter-cursor {
    animation: blink 1s steps(1) infinite;
    color: var(--accent);
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
