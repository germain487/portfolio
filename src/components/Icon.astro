---
import { existsSync, readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { join } from 'node:path';

interface Props {
  name: string;
  class?: string;
  size?: number;
  strokeWidth?: number;
}

const { name, class: className = '', size = 24, strokeWidth } = Astro.props;

// Les icônes maison (src/icons/) priment sur Lucide : elles comblent ses
// absences — notamment les marques, que ce jeu d'icônes ne couvre pas.
// Résolu depuis la racine du projet : au build, `import.meta.url` pointe vers
// dist/ et non vers les sources, ce qui ferait manquer le dossier src/icons.
const localPath = join(process.cwd(), 'src/icons', `${name}.svg`);
const lucidePath = fileURLToPath(
  new URL(`../../node_modules/lucide-static/icons/${name}.svg`, import.meta.url)
);
let raw = readFileSync(existsSync(localPath) ? localPath : lucidePath, 'utf-8');

raw = raw
  .replace(/<!--[\s\S]*?-->\n?/, '')
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/class="[^"]*"/, `class="${className}"`.trim())
  .replace(/\n/g, '');

if (strokeWidth) {
  raw = raw.replace(/stroke-width="2"/, `stroke-width="${strokeWidth}"`);
}
---
<Fragment set:html={raw} />
