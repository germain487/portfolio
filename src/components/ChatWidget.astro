---
// Bulle + panneau de Louise, persistants entre les pages (transition:persist,
// comme la navbar et le curseur). Le HTML est statique et léger — la logique
// (ouverture, envoi de messages, appel de la fonction Netlify) ne se charge
// qu'à la première ouverture, via import dynamique dans scripts/motion.ts
// (voir initChatWidget), pour ne rien ajouter au JS initial du site.
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';

const chatbotEntry = await getEntry('chatbot', 'chatbot');
const chatbot = chatbotEntry?.data;

const bulleStyle = (() => {
  if (!chatbot) return '';
  const hex = chatbot.couleurBulle;
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
  return [
    `--bulle: ${hex}`,
    `--bulle-glow: 0 0 24px rgba(${r}, ${g}, ${b}, 0.35)`,
    `--bulle-glow-strong: 0 0 48px rgba(${r}, ${g}, ${b}, 0.45)`,
  ].join('; ');
})();
---

{
  chatbot?.actif && (
    <div
      data-chat-widget
      style={bulleStyle}
      data-chat-greeting={chatbot.messageAccueil}
      data-chat-offline={chatbot.messageIndisponible}
      data-chat-animation={chatbot.animationAttention}
      transition:persist="chat-widget"
    >
      {chatbot.animationAttention === 'heartbeat_radar' && (
        <svg
          data-chat-radar
          aria-hidden="true"
          viewBox="-2 -2 104 104"
          class="chat-radar fixed bottom-6 right-6 z-30 h-14 w-14"
        >
          <polygon points="25,0 75,0 100,50 75,100 25,100 0,50" fill="none" stroke="var(--bulle)" stroke-width="3" />
        </svg>
      )}

      <button
        type="button"
        data-chat-toggle
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="louise-panel"
        aria-label={chatbot.libelleBouton}
        title={chatbot.libelleBouton}
        class="chat-bubble fixed bottom-6 right-6 z-40 grid h-14 w-14 place-items-center text-bg"
      >
        <span data-chat-icon-open class="grid place-items-center text-2xl leading-none">{chatbot.iconeBulle}</span>
        <span data-chat-icon-close class="hidden place-items-center">
          <Icon name="x" size={20} />
        </span>
      </button>

      {chatbot.badgeInvitationActif && (
        <div
          data-chat-badge
          hidden
          class="chat-badge fixed bottom-24 right-6 z-40 flex max-w-[15rem] items-start gap-1 rounded-card border border-surface-2 bg-surface py-2 pl-4 pr-1.5 text-sm text-text"
        >
          <button type="button" data-chat-badge-open class="py-0.5 text-left leading-snug">
            {chatbot.badgeInvitationTexte}
          </button>
          <button
            type="button"
            data-chat-badge-close
            aria-label="Fermer l’invitation"
            class="grid h-6 w-6 shrink-0 place-items-center rounded-full text-text-muted transition-colors hover:text-text"
          >
            <Icon name="x" size={12} />
          </button>
        </div>
      )}

      <div
        id="louise-panel"
        data-chat-panel
        role="dialog"
        aria-modal="false"
        aria-labelledby="louise-panel-title"
        hidden
        class="chat-panel fixed bottom-24 right-6 z-40 flex w-[calc(100vw-3rem)] max-w-sm flex-col overflow-hidden rounded-card border border-surface-2 bg-surface"
      >
        <header class="flex items-center justify-between gap-3 border-b border-surface-2 px-5 py-4">
          <div class="flex items-center gap-3">
            <span class="relative grid h-9 w-9 shrink-0 place-items-center" aria-hidden="true">
              <svg viewBox="0 0 100 100" class="h-full w-full">
                <polygon
                  points="50,4 91,27 91,73 50,96 9,73 9,27"
                  fill="var(--surface-2)"
                  stroke="var(--bulle)"
                  stroke-width="5"
                />
              </svg>
              <span class="absolute inset-0 grid place-items-center text-base leading-none">{chatbot.iconeBulle}</span>
            </span>
            <div>
              <p id="louise-panel-title" class="font-display text-sm font-bold text-text">{chatbot.titrePanneau}</p>
              <p class="font-mono text-[0.65rem] uppercase tracking-[0.1em] text-text-muted">{chatbot.mentionIA}</p>
            </div>
          </div>
          <button
            type="button"
            data-chat-close
            aria-label="Fermer la discussion"
            class="grid h-8 w-8 shrink-0 place-items-center rounded-full text-text-muted transition-colors hover:text-text"
          >
            <Icon name="x" size={16} />
          </button>
        </header>

        <div data-chat-messages class="chat-messages flex-1 space-y-3 overflow-y-auto px-5 py-4" aria-live="polite" />

        <div data-chat-suggestions class="flex flex-wrap gap-2 px-5 pb-3">
          {chatbot.questionsSuggerees.map((question) => (
            <button
              type="button"
              data-chat-suggestion
              class="rounded-pill border border-surface-2 px-3 py-1.5 text-left font-mono text-xs text-text-muted transition-colors hover:border-accent/40 hover:text-text"
            >
              {question}
            </button>
          ))}
        </div>

        <form data-chat-form class="flex items-center gap-2 border-t border-surface-2 px-4 py-3">
          <label for="louise-input" class="sr-only">Votre message</label>
          <input
            id="louise-input"
            data-chat-input
            type="text"
            maxlength="500"
            autocomplete="off"
            placeholder={chatbot.placeholderSaisie}
            required
            class="form-field w-full rounded-pill border border-surface-2 bg-bg px-4 py-2.5 text-sm text-text outline-none transition-colors duration-300 focus:border-accent"
          />
          <button
            type="submit"
            data-chat-send
            aria-label="Envoyer"
            class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-accent text-bg transition-transform duration-300 hover:scale-105 disabled:opacity-50"
          >
            <Icon name="send" size={16} />
          </button>
        </form>
      </div>
    </div>
  )
}

<style>
  /* Bulle : apparaît 1,5 s après le chargement (chat-bubble-enter). Le
     battement de cœur ne joue que sous .is-beating, posée par salves depuis
     scripts/motion.ts (initChatAttention) : 3 itérations puis la CSS s'arrête
     seule, exactement en fin de cycle — aucun timer JS n'a à deviner quand
     couper, donc pas de bulle figée en plein pic si un timer dérive. */
  .chat-bubble {
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
    background: var(--bulle);
    box-shadow: var(--bulle-glow);
    opacity: 0;
    transform: scale(0.4);
    pointer-events: none;
    will-change: transform;
    animation: chat-bubble-enter 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.5s 1 forwards;
  }
  .chat-bubble.is-beating {
    animation:
      chat-bubble-enter 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.5s 1 forwards,
      chat-heartbeat 1.3s ease-in-out 3;
  }
  .chat-bubble:hover {
    animation-play-state: running, paused !important;
    transform: scale(1.05) !important;
    box-shadow: var(--bulle-glow-strong) !important;
  }
  @keyframes chat-bubble-enter {
    to {
      opacity: 1;
      transform: scale(1);
      pointer-events: auto;
    }
  }
  /* Rythme « lub-dub » (~55 bpm) : deux pulsations rapprochées puis un temps
     de repos jusqu'à la fin du cycle. */
  @keyframes chat-heartbeat {
    0%, 100% {
      transform: scale(1);
      box-shadow: var(--bulle-glow);
    }
    14% {
      transform: scale(1.12);
      box-shadow: var(--bulle-glow-strong);
    }
    28% {
      transform: scale(1);
      box-shadow: var(--bulle-glow);
    }
    42% {
      transform: scale(1.14);
      box-shadow: var(--bulle-glow-strong);
    }
    70% {
      transform: scale(1);
      box-shadow: var(--bulle-glow);
    }
  }

  /* Onde radar : une seule pulsation par salve de battements, déclenchée en
     JS (classe .is-pinging ajoutée puis retirée à chaque salve). Anneau tracé
     en SVG : un border + clip-path hexagonal ne donnerait que deux barres,
     le contour d'une boîte ne suivant pas les côtés obliques du polygone. */
  .chat-radar {
    opacity: 0;
    pointer-events: none;
  }
  .chat-radar.is-pinging {
    animation: chat-radar-ping 1s ease-out 1;
  }
  @keyframes chat-radar-ping {
    from {
      transform: scale(1);
      opacity: 0.5;
    }
    to {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  /* Infobulle d'invitation : indépendante du réglage d'animation ci-dessus.
     Persistante jusqu'à ouverture ou fermeture explicite (scripts/motion.ts). */
  .chat-badge {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }
  .chat-badge.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  /* Petite flèche vers la bulle, dans la continuité du bord de l'infobulle. */
  .chat-badge::after {
    content: '';
    position: absolute;
    right: 1.25rem;
    bottom: -0.4rem;
    width: 0.75rem;
    height: 0.75rem;
    background: var(--surface);
    border-right: 1px solid var(--surface-2);
    border-bottom: 1px solid var(--surface-2);
    transform: rotate(45deg);
  }

  .chat-panel {
    max-height: min(30rem, calc(100vh - 8rem));
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .chat-panel.is-open {
    opacity: 1;
    transform: none;
  }
  .chat-messages {
    scrollbar-width: thin;
  }
  @media (max-width: 380px) {
    .chat-panel {
      right: 1rem;
      bottom: 5.5rem;
    }
    .chat-bubble,
    .chat-radar,
    .chat-badge {
      right: 1rem;
    }
    /* Empreinte réduite : sur petit écran, le badge reste une pastille
       compacte collée à la bulle plutôt qu'un large bandeau qui recouvrirait
       davantage le contenu de la page en dessous. */
    .chat-badge {
      max-width: 12rem;
      padding: 0.4rem 0.25rem 0.4rem 0.75rem;
      font-size: 0.75rem;
    }
  }

  /* La bulle reste statique, visible immédiatement, glow fixe — jamais de
     battement ni d'onde radar. Le badge n'est pas concerné : c'est un texte
     informatif, pas un mouvement, et sa propre transition est déjà neutralisée
     par la règle globale prefers-reduced-motion (src/styles/global.css). */
  @media (prefers-reduced-motion: reduce) {
    .chat-bubble,
    .chat-bubble.is-beating {
      opacity: 1;
      transform: none;
      animation: none;
      box-shadow: var(--bulle-glow);
      pointer-events: auto;
    }
    .chat-radar {
      display: none;
    }
  }
</style>
